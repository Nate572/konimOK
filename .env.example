FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ADMIN_EMAIL=
# Routing/geocoding via https://openrouteservice.org/
ORS_API_KEY=
