rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function signedInAs(uid) { return request.auth != null && request.auth.uid == uid; }
   function validList() {
     return request.resource.data.keys().hasOnly(['name','items','updatedAt','createdAt','archived'])
       && request.resource.data.name is string && request.resource.data.name.size() <= 100
       && request.resource.data.items is list && request.resource.data.items.size() <= 150
       && request.resource.data.archived is bool;
   }
   match /households/{uid} {
     allow read: if signedInAs(uid);
     allow write: if false;
     match /lists/{listId} {
       allow read, delete: if signedInAs(uid);
       allow create, update: if signedInAs(uid) && validList();
     }
   }
 }
}
